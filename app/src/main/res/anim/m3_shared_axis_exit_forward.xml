<?xml version="1.0" encoding="utf-8"?>
<!-- Material shared X axis -->
<set xmlns:android="http://schemas.android.com/apk/res/android"
    android:interpolator="@interpolator/m3_emphasized_decelerate">
    <translate
        android:duration="300"
        android:fromXDelta="0%"
        android:toXDelta="-10%" />
    <alpha
        android:duration="90"
        android:startOffset="0"
        android:fromAlpha="1"
        android:toAlpha="0" />
</set>
