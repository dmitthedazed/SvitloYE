<?xml version="1.0" encoding="utf-8"?>
<!-- Widget-picker preview for Android 12–14; Android 15+ gets a generated one (ScheduleWidget.providePreview). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_preview_card"
    android:backgroundTint="@color/widget_preview_surface"
    android:orientation="vertical"
    android:padding="16dp"
    tools:ignore="HardcodedText">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <FrameLayout
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:background="@drawable/widget_preview_pill"
            android:backgroundTint="@color/widget_preview_primary_container">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:layout_gravity="center"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_bolt"
                android:tint="@color/widget_preview_on_primary_container" />
        </FrameLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="sans-serif-medium"
                android:maxLines="1"
                android:text="@string/widget_state_on"
                android:textColor="@color/widget_preview_on_surface"
                android:textSize="16sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:text="Відключення о 17:00 · Дім"
                android:textColor="@color/widget_preview_on_surface_variant"
                android:textSize="12sp" />
        </LinearLayout>

        <ImageView
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_marginHorizontal="12dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_refresh"
            android:tint="@color/widget_preview_on_surface_variant" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="20dp"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="3"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_error" />
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="7"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_secondary_container" />
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="2"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_error_container" />
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="5"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_secondary_container" />
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="3"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_error" />
            <View
                android:layout_width="0dp"
                android:layout_height="12dp"
                android:layout_marginHorizontal="1dp"
                android:layout_weight="4"
                android:background="@drawable/widget_preview_pill"
                android:backgroundTint="@color/widget_preview_secondary_container" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:orientation="horizontal">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="06"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="12"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="18"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp" />
        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="24"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="10sp" />
    </LinearLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="2dp"
        android:fontFamily="sans-serif-medium"
        android:text="@string/widget_upcoming"
        android:textColor="@color/widget_preview_on_surface_variant"
        android:textSize="11sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/widget_preview_pill"
            android:backgroundTint="@color/widget_preview_error" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="17:00 – 20:00"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Відключення"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="3 год"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="4dp">

        <View
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:background="@drawable/widget_preview_pill"
            android:backgroundTint="@color/widget_preview_secondary_container" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
            android:fontFamily="sans-serif-medium"
            android:text="20:00 – 24:00"
            android:textColor="@color/widget_preview_on_surface"
            android:textSize="13sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:maxLines="1"
            android:text="Світло є"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="13sp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="4 год"
            android:textColor="@color/widget_preview_on_surface_variant"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
